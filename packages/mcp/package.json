{
  "name": "@contenthero/mcp",
  "version": "0.4.51",
  "description": "Official ContentHero MCP server. Generate images, video, and audio from any MCP client (Claude Code, Claude Desktop, etc.) using your ContentHero API key.",
  "type": "module",
  "bin": {
    "contenthero-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node widget/guard.mjs && tsc --noEmit -p widget/tsconfig.json && node widget/build.mjs && tsc --emitDeclarationOnly && node build-server.mjs",
    "clean": "rm -rf dist",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "verify:inline": "node scripts/verify-inline-media.mjs",
    "verify:tarball": "node scripts/verify-tarball.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contenthero-ai/contenthero-sdk.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "contenthero",
    "mcp",
    "model-context-protocol",
    "ai",
    "image-generation",
    "video-generation",
    "text-to-speech"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "private": false,
  "dependencies": {
    "@contenthero/sdk": "workspace:^",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@contenthero-ai/brand-ui": "workspace:*",
    "@lobehub/icons": "5.10.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "esbuild": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "^4.22.3"
  }
}
